# Supabase (required for cloud database/auth/storage)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use ONE of these client-side keys from Supabase Project Settings > API.
# New Supabase projects may label it Publishable key; older projects label it anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxx

# EmailJS (optional; used for OTP and workflow notification emails)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxx
# Workflow notification CC. Do not use this for OTP/security emails.
VITE_EMAILJS_CC_EMAIL=pttlng-marinelmpt2@pttlng.com
# Comma-separated recipients for new-registration notifications.
# narudech.s@pttlng.com is also included by the app automatically.
VITE_ADMIN_NOTIFICATION_EMAILS=papawich.p@pttlng.com,narudech.s@pttlng.com
